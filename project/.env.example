# Copy this file to `.env.local` to enable the "Ask Circuit" AI assistant tab.
# Without a key, the assistant tab shows a friendly setup message; the rest of
# the app works fully.

OPENAI_API_KEY=sk-your-key-here

# Optional - model and reasoning effort. Default: gpt-5.4-mini at medium effort.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=medium
